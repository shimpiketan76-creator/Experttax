{
  "entities": {
    "Review": {
      "title": "Customer Review",
      "description": "A review submitted by a customer for the services provided.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the reviewer." },
        "content": { "type": "string", "description": "The review text." },
        "rating": { "type": "number", "description": "Rating out of 5." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of the review." },
        "lang": { "type": "string", "description": "Language code (en, hi, mr, gu)." }
      },
      "required": ["name", "content", "rating", "createdAt"]
    }
  },
  "firestore": {
    "reviews": {
      "schema": "Review",
      "description": "Public collection of customer reviews."
    }
  }
}
