{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "Customer feedback and reviews",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lang": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["name", "content", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of customer reviews"
    }
  }
}
