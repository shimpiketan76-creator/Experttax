rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true; // Allow guests and users to post reviews for now, can harden later if specified
      allow update, delete: if false;
    }
  }
}
