rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'content', 'rating', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time &&
             (data.userId == null || (isSignedIn() && data.userId == request.auth.uid));
    }

    match /reviews/{reviewId} {
      // Publicly readable for testimonials
      allow read: if true;
      
      // Verified write with schema validation
      allow create: if isValidReview(request.resource.data);
      
      // No updates or deletes allowed for now to keep history intact
      allow update, delete: if false;
    }
  }
}
